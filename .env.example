# ──────────────────────────────────────────────────────────
# Copie ce fichier en `.env` puis remplis les valeurs.
#   cp .env.example .env
# Ne commite JAMAIS le vrai .env (déjà dans .gitignore).
# ──────────────────────────────────────────────────────────

# Domaine public de l'app, servi par un reverse proxy TLS EXTERNE à la stack
# (l'app elle-même écoute en HTTP sur :3000).
APP_DOMAIN=localhost
# URL complète VUE PAR LES NAVIGATEURS (liens dans les courriels, Better Auth).
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ── PostgreSQL ──
POSTGRES_USER=cityresa
POSTGRES_PASSWORD=change-moi-mot-de-passe-fort
POSTGRES_DB=cityresa
# En Docker : construite dans docker-compose.yml. En dev local, décommente :
# DATABASE_URL=postgresql://cityresa:change-moi-mot-de-passe-fort@localhost:5435/cityresa?schema=public

# ── Better Auth ──
# Racine de tout ce que l'application chiffre ou signe (secrets TOTP, mots de passe
# SMTP / SMS, codes de signature). Génère : openssl rand -base64 32
BETTER_AUTH_SECRET=change-moi-secret-aleatoire
# Origines supplémentaires de confiance (anti-CSRF), séparées par des virgules.
# TRUSTED_ORIGINS=
# Cookie de session sans attribut Secure (test LAN en HTTP d'un build de prod).
# ALLOW_INSECURE_COOKIES=true

# ── Compte administrateur initial (db:init) ──
# Vide = mot de passe aléatoire affiché en console au premier démarrage.
# ADMIN_INITIAL_PASSWORD=
ADMIN_EMAIL=admin@localhost

# ── Cron ──
# Secret partagé entre le conteneur cron et les routes /api/cron. Génère : openssl rand -hex 24
CRON_SECRET=change-moi-cron-secret
# Hors conteneur cron (développement), les tâches planifiées tournent dans le processus.
DEV_SCHEDULER=true

# ── Sécurité ──
SESSION_LIFETIME_MINUTES=480
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Imposer la double authentification aux comptes administrateur.
REQUIRE_2FA_ADMIN=false
# Faire confiance à X-Forwarded-For (uniquement derrière un reverse proxy de confiance).
TRUST_PROXY=false

# ── Replis .env des réglages gérés depuis Paramètres (clés MANAGED, en base) ──
COLLECTIVITE_NOM=Ville de Châtillon
COLLECTIVITE_ADRESSE=1 place de la Libération, 92320 Châtillon
COLLECTIVITE_EMAIL=reservations@chatillon92.fr
COLLECTIVITE_TELEPHONE=
COLLECTIVITE_SITE_WEB=https://www.ville-chatillon.fr
UI_PRIMARY_COLOR=
MAIL_ENABLED=true
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@localhost
# SMS (signature de convention, rappels) : 'console' (journal), 'http' (passerelle générique)
SMS_ENABLED=false
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=CityResa

# Fonctionnalités (toutes modifiables depuis Paramètres)
PORTAIL_ENABLED=true
INSCRIPTION_ENABLED=true
PAIEMENTS_ENABLED=true
SIGNATURE_ENABLED=true
MATERIEL_ENABLED=true
SUBVENTIONS_ENABLED=true
DOCUMENTS_ENABLED=true
DOCUMENT_MAX_MB=10
TVA_TAUX=0
RAPPEL_J7=true
RAPPEL_J1=true
RELANCE_SIGNATURE_JOURS=3
ARCHIVAGE_AUTO_JOURS=30
DELAI_ANNULATION_JOURS=7
# RGPD : mois d'inactivité avant anonymisation d'un compte usager (0 = jamais), préavis en jours,
# années de conservation d'un dossier terminé avant purge de ses données personnelles (0 = jamais)
RGPD_INACTIVITE_MOIS=36
RGPD_PREAVIS_JOURS=30
RGPD_CONSERVATION_ANNEES=5

# Sauvegarde automatique de la base (pg_dump quotidien à 01:00)
BACKUP_DB_DIR=
BACKUP_DB_KEEP=14
# PG_DUMP_BIN=docker exec cityresa-pg pg_dump
# PG_DUMP_URL=postgresql://cityresa:change-moi-mot-de-passe-fort@localhost:5432/cityresa

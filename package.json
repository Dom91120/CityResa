{
  "name": "cityresa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:init": "tsx prisma/seed-init.ts",
    "db:demo": "tsx prisma/seed-demo.ts",
    "illustration": "node scripts/illustration-connexion.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@better-auth/utils": "0.5.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "archiver": "^7.0.1",
    "better-auth": "^1.7.5",
    "chart.js": "^4.4.1",
    "exceljs": "^4.4.0",
    "next": "^16.3.8",
    "nodemailer": "^10.3.1",
    "puppeteer": "^25.11.0",
    "qrcode": "1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@fontsource/poppins": "^5.2.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^6.0.3",
    "@types/node": "^26.6.1",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "lucide-static": "^1.64.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  }
}
